# Copy this file to `.env.mail` and fill with real SMTP values.
# `.env.mail` is used by `public/api/contact.php`.

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_APP_ENV=production
MAIL_SMTP_AUTH=true
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=AronaTech Portfolio
MAIL_OWNER_ADDRESS=owner@example.com
MAIL_OWNER_NAME=AronaTech Owner
MAIL_SITE_NAME=AronaTech Portfolio
MAIL_SITE_URL=https://aronatech.cloud
MAIL_ALLOWED_ORIGINS=https://aronatech.cloud
