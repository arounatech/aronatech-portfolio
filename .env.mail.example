# Copy this file to `.env.mail` and fill with real SMTP values.
# `.env.mail` is used by `public/api/contact.php`.

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Portfolio Contact
MAIL_TO_ADDRESS=you@example.com
MAIL_TO_NAME=Portfolio Owner
